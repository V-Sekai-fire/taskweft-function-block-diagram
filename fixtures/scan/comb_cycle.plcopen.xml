      <inVariable localId="1"><expression>a</expression></inVariable>
      <block localId="2" typeName="AND">
        <inputVariables>
          <variable formalParameter="IN1"><connectionPointIn><connection refLocalId="1" formalParameter="OUT"/></connectionPointIn></variable>
